{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@search-hub/shared": ["packages/shared/src/index.ts"],
      "@search-hub/db": ["packages/db/src/index.ts"],
      "@search-hub/core": ["packages/core/src/index.ts"],
      "@search-hub/providers": ["packages/providers/src/index.ts"],
      "@search-hub/models": ["packages/models/src/index.ts"],
      "@search-hub/mcp": ["packages/mcp/src/index.ts"]
    }
  }
}
