# Build context hygiene: never ship local dependencies, data, or build output.
node_modules
**/node_modules
.data
data
dist
**/dist
# Local SQLite files and backups must never reach a layer, even by accident.
*.db
*.db-wal
*.db-shm
*.db-journal
test-results
playwright-report
coverage
.git
.github
*.log
.env
.env.*
!.env.example
.shots
.smoke-*
tmp
# Local agent/workspace scratch data (may contain tokens).
.workbuddy
