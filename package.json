{
  "name": "search-hub",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "description": "Open-source, self-hosted AI search infrastructure: multi-provider aggregation, key pools, MCP, and agent skills.",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @search-hub/api dev\" \"pnpm --filter @search-hub/web dev\"",
    "dev:api": "pnpm --filter @search-hub/api dev",
    "dev:web": "pnpm --filter @search-hub/web dev",
    "build": "pnpm --filter @search-hub/web build && node scripts/build-server.mjs && pnpm --filter @search-hub/cli build",
    "start": "node apps/api/dist/server.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "resource:doctor": "node scripts/resource-doctor.mjs",
    "evidence:build": "node scripts/build-resource-evidence.mjs",
    "evidence:verify": "node packaging/verify-resource-evidence.mjs",
    "release:gate": "node packaging/check-release-gates.mjs",
    "verify:smart": "node scripts/verify-smart.mjs",
    "test:lowmem": "node scripts/test-lowmem.mjs",
    "cache:inspect": "node scripts/cache-maintenance.mjs inspect",
    "cache:prune": "node scripts/cache-maintenance.mjs prune",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "oxlint packages apps tests",
    "lint:fix": "oxlint --fix packages apps tests",
    "build:server": "node scripts/build-server.mjs",
    "build:cli": "pnpm --filter @search-hub/cli build",
    "test:cli": "vitest run tests/unit/cli tests/integration/cli",
    "start:dev": "pnpm --filter @search-hub/api dev",
    "mcp:stdio": "node packages/mcp/dist/stdio.mjs",
    "test:launcher": "node packaging/launcher/lifecycle-test.mjs",
    "verify:package": "node packaging/verify-package.mjs",
    "check:docs": "node --import tsx scripts/check-doc-consistency.mjs",
    "check:docs:final": "node scripts/check-readme-consistency.mjs --mode final",
    "check:matrix": "node --import tsx scripts/generate-provider-matrix.mjs --check",
    "quality:eval": "node --import tsx scripts/quality-eval.mjs",
    "generate:matrix": "node --import tsx scripts/generate-provider-matrix.mjs",
    "test:updater": "node packaging/launcher/updater-test.mjs",
    "test:upgrade": "node packaging/upgrade-matrix.mjs",
    "test:faults": "node packaging/launcher/updater-faults.mjs",
    "audit:supply-chain": "node packaging/supply-chain-audit.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "age-encryption": "0.3.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.8",
    "koffi": "^3.3.8",
    "oxlint": "^1.93.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
