# Search Hub environment template.
# Copy to .env and adjust. Every value is optional except where noted.

# --- runtime ---
NODE_ENV=production
SEARCH_HUB_HOST=0.0.0.0
SEARCH_HUB_PORT=8787

# --- storage ---
# Directory for the SQLite database and the generated master key.
SEARCH_HUB_DATA_DIR=./data
# Override only if you keep the database somewhere else.
# SEARCH_HUB_DB_PATH=./data/search-hub.db

# --- secrets ---
# Master key used to encrypt provider/model API keys (AES-256-GCM).
# Must be 64 hex characters: openssl rand -hex 32
# If unset, Search Hub generates data/master.key on first start.
# BACK THIS UP together with the database, or stored keys become unreadable.
# SEARCH_HUB_ENCRYPTION_KEY=

# One-time token required by the first-run setup page.
# Leave empty to auto-generate <data>/setup-token (mode 0600) and print it to
# the log on first boot. The file is removed after initialization.
# SEARCH_HUB_SETUP_TOKEN=

# Extra hostnames accepted in the Host header (comma separated).
# IP literals and localhost are always accepted; set this when the UI is
# reached through a domain other than SEARCH_HUB_PUBLIC_URL.
# SEARCH_HUB_ALLOWED_HOSTS=hub.internal,192.168.1.20

# --- public deployment ---
# Used in MCP/Skill examples. Set it when behind a reverse proxy.
# SEARCH_HUB_PUBLIC_URL=https://search.example.com
# Only enable when the instance is served over HTTPS.
# SEARCH_HUB_COOKIE_SECURE=true
# Reverse proxy trust. "true" trusts ONLY loopback proxies (127.0.0.1/8, ::1).
# For a proxy on another host/container, give its CIDR explicitly, e.g.
# SEARCH_HUB_TRUST_PROXY=172.17.0.0/16
# SEARCH_HUB_TRUST_PROXY=false
# Comma separated extra origins allowed for browser API access.
# SEARCH_HUB_CORS_ORIGINS=https://app.example.com

# --- operations ---
SEARCH_HUB_LOG_LEVEL=info
# Point to a pre-built web bundle if you do not use the Docker image.
# SEARCH_HUB_STATIC_DIR=./apps/web/dist
# Where the compiled server finds the *.sql migrations.
# SEARCH_HUB_MIGRATIONS_DIR=./packages/db/migrations
# Maximum size accepted by POST /api/admin/backup/verify (bytes, default 64 MB).
# SEARCH_HUB_BACKUP_MAX_UPLOAD_BYTES=67108864

# --- docker compose only (ignored by the bare-metal install) ---
# Host port published by compose. Change it when 8787 is already taken.
# SEARCH_HUB_HOST_PORT=8787
# Container name; set it when running two stacks on the same host.
# SEARCH_HUB_CONTAINER_NAME=search-hub
# Use a published image instead of a local build.
# SEARCH_HUB_IMAGE=ghcr.io/search-hub/search-hub:0.1.2
# Hard memory ceiling for the container.
# SEARCH_HUB_MEM_LIMIT=1g

# --- outbound network (optional HTTP proxy) ---
# Every provider and model request goes through an http(s) forward proxy.
# Leave empty for direct connections (default). socks://, pac+http:// and
# file:// proxies are rejected at boot: they cannot be combined with the
# application-layer SSRF checks. Credentials may be embedded as
# http://user:pass@proxy:port — they are never logged or returned by the API.
# The SEARCH_HUB_OUTBOUND_* names are accepted as aliases of the three below.
# SEARCH_HUB_PROXY=http://proxy.internal:3128
# Hosts that skip the proxy (NO_PROXY semantics: *.example.com, host:port,
# 10.0.0.0/8, *). Bypassed targets are still SSRF-validated.
# SEARCH_HUB_NO_PROXY=localhost,127.0.0.1,.internal
# Trust level of the proxy. There is NO default: leave it unset and proxied
# requests are still restricted to application-validated public targets, with a
# warning on /api/health that the boundary is undeclared.
#   untrusted        (alias: application-only)  only app-layer URL/DNS checks
#                    protect proxied requests; the proxy resolves the
#                    destination, so DNS rebinding at the proxy cannot be
#                    detected here. The private host allowlist is ignored for
#                    proxied requests.
#   trusted-networks (alias: egress-enforced)   the operator declares the proxy
#                    itself blocks internal ranges. Only then may allowlisted
#                    private targets go through the proxy.
# SEARCH_HUB_PROXY_TRUST=untrusted
# Ambient HTTP_PROXY / HTTPS_PROXY / ALL_PROXY / NO_PROXY are ignored by
# default, because they are often inherited from a shell or CI runner. Opting
# in still requires SEARCH_HUB_PROXY_TRUST, or boot fails.
# SEARCH_HUB_PROXY_FROM_ENV=false
